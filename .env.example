# Public URL where the FastAPI service runs in local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Required when database-backed features begin. Do not commit real credentials.
MONGODB_URI=
VERDICT_SESSION_SECRET=
# Leave false for HTTP localhost. Set true for every HTTPS deployment.
VERDICT_COOKIE_SECURE=false
# Comma-separated browser origins allowed to send authenticated API requests.
# Example production value: https://app.example.com
VERDICT_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Official Facebook Login for Business credentials. Never paste real values in chat.
META_APP_ID=
META_APP_SECRET=
# Legacy Unified Login configuration; leave blank for Verdict's Facebook Login flow.
META_INSTAGRAM_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
META_API_VERSION=v27.0
# Required before official OAuth is enabled. Generate a Fernet key locally; never paste it in chat.
META_TOKEN_ENCRYPTION_KEY=
GROQ_API_KEY=
# xAI Grok is a separate provider from Groq. It reads up to three local strategic stills.
XAI_API_KEY=
# Reel analysis provider: `gemini` uploads a private video; `groq` and `xai` review
# up to three locally extracted strategic stills (opening, hook-end, and material change).
VERDICT_REEL_ANALYSIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_REEL_MODEL=qwen/qwen3.8-27b
XAI_REEL_MODEL=grok-4.7

# Local judge-demo fixture only. Never enable this in production or point it at
# real creator data. The fixture is visibly labeled synthetic in Verdict.
VERDICT_DEMO_MODE=false
VERDICT_DEMO_FIXTURE_PATH=
